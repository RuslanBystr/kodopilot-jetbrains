<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.ruslanbystr.kodopilotplugin</id>
    <name>KodoPilot</name>
    <vendor>Bystranskyi R.R.</vendor>
    <description><![CDATA[
<p><b>KodoPilot</b> is an AI-powered plugin that enhances your development workflow with LLM-driven code assistance, helping you write, refactor, and understand code faster and more efficiently.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="com.github.ruslanbystr.kodopilotplugin.settings.KodoPilotSettingsConfigurable"
                id="com.github.ruslanbystr.kodopilotplugin.settings.KodoPilotSettingsConfigurable"
                displayName="KodoPilot"
        />

        <notificationGroup id="KodoPilot Notifications" displayType="BALLOON"/>

        <toolWindow
                factoryClass="com.github.ruslanbystr.kodopilotplugin.toolWindow.MyToolWindowFactory"
                id="KodoPilot"
                icon="/icons/kodopilot.svg"
        />

        <postStartupActivity implementation="com.github.ruslanbystr.kodopilotplugin.startup.MyProjectActivity" />
    </extensions>

    <actions>
        <action
            id="KodoPilot.KodoPilotFixAction"
            class="com.github.ruslanbystr.kodopilotplugin.actions.KodoPilotFixAction"
            text="Fix/Refactor Code"
            description="AI powered analyzing"
            icon="/icons/ai-sparkle-13x13.svg"
        >

            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
        <action
                id="KodoPilot.AskAiAction"
                class="com.github.ruslanbystr.kodopilotplugin.actions.AskAiAction"
                text="Ask AI"
                description="Edit current file using AI"
                icon="/icons/ai-prompt-terminal-13x13.svg">

            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt g"/>
        </action>
    </actions>
</idea-plugin>
